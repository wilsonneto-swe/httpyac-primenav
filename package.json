{
  "name": "httpyac-primenav",
  "displayName": "httpYac - PrimeNav",
  "description": "Stop scrolling through .http files. Workspace-wide navigation tree, global search, and pin feature. Then send via httpYac.",
  "version": "0.3.1",
  "publisher": "wilsonneto-swe",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "http",
    "rest",
    "httpyac",
    "navigation",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wilsonneto-swe/httpyac-primenav.git"
  },
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:http",
    "onView:httpyacPrimeNav.tree",
    "onView:httpyacPrimeNav.currentFileTree"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "httpyacPrimeNav",
          "title": "httpYac PrimeNav",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "httpyacPrimeNav": [
        {
          "id": "httpyacPrimeNav.currentFileTree",
          "name": "Current File",
          "when": "httpyac-primenav.activeHttpFile"
        },
        {
          "id": "httpyacPrimeNav.tree",
          "name": "Workspace Requests"
        }
      ]
    },
    "commands": [
      {
        "command": "httpyac-primenav.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.search",
        "title": "Search Requests…",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.reveal",
        "title": "Reveal Request",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.send",
        "title": "Send Request",
        "icon": "$(play)",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.runFileTests",
        "title": "Run File Tests",
        "icon": "$(play)",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.pin",
        "title": "Pin Request",
        "icon": "$(pin)",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.unpin",
        "title": "Unpin Request",
        "icon": "$(pinned)",
        "category": "httpYac PrimeNav"
      },
      {
        "command": "httpyac-primenav.removePin",
        "title": "Remove Stale Pin",
        "icon": "$(close)",
        "category": "httpYac PrimeNav"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "httpyac-primenav.search",
          "when": "view == httpyacPrimeNav.tree",
          "group": "navigation@1"
        },
        {
          "command": "httpyac-primenav.refresh",
          "when": "view == httpyacPrimeNav.tree",
          "group": "navigation@2"
        },
        {
          "command": "httpyac-primenav.runFileTests",
          "when": "view == httpyacPrimeNav.currentFileTree && httpyac-primenav.httpyacAvailable && httpyac-primenav.activeHttpFile",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "httpyac-primenav.pin",
          "when": "(view == httpyacPrimeNav.tree || view == httpyacPrimeNav.currentFileTree) && viewItem == request",
          "group": "inline@1"
        },
        {
          "command": "httpyac-primenav.unpin",
          "when": "(view == httpyacPrimeNav.tree || view == httpyacPrimeNav.currentFileTree) && viewItem == request-pinned",
          "group": "inline@1"
        },
        {
          "command": "httpyac-primenav.send",
          "when": "(view == httpyacPrimeNav.tree || view == httpyacPrimeNav.currentFileTree) && viewItem == request && httpyac-primenav.httpyacAvailable",
          "group": "inline@2"
        },
        {
          "command": "httpyac-primenav.send",
          "when": "(view == httpyacPrimeNav.tree || view == httpyacPrimeNav.currentFileTree) && viewItem == request-pinned && httpyac-primenav.httpyacAvailable",
          "group": "inline@2"
        },
        {
          "command": "httpyac-primenav.runFileTests",
          "when": "view == httpyacPrimeNav.tree && viewItem == file && httpyac-primenav.httpyacAvailable",
          "group": "inline@1"
        },
        {
          "command": "httpyac-primenav.removePin",
          "when": "view == httpyacPrimeNav.tree && viewItem == stale-pin",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "httpyac-primenav.reveal",
          "when": "false"
        },
        {
          "command": "httpyac-primenav.pin",
          "when": "false"
        },
        {
          "command": "httpyac-primenav.unpin",
          "when": "false"
        },
        {
          "command": "httpyac-primenav.removePin",
          "when": "false"
        },
        {
          "command": "httpyac-primenav.runFileTests",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "httpyac-primenav.search",
        "args": {
          "scope": "file"
        },
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      },
      {
        "command": "httpyac-primenav.search",
        "args": {
          "scope": "workspace"
        },
        "key": "ctrl+alt+h",
        "mac": "cmd+ctrl+h"
      }
    ],
    "configuration": {
      "title": "httpYac PrimeNav",
      "properties": {
        "httpyacPrimeNav.fileGlob": {
          "type": "string",
          "default": "**/*.{http,rest}",
          "description": "Glob used to discover request files."
        },
        "httpyacPrimeNav.excludeGlob": {
          "type": "string",
          "default": "**/node_modules/**",
          "description": "Glob excluded from discovery."
        },
        "httpyacPrimeNav.groupBySections": {
          "type": "boolean",
          "default": true,
          "description": "Group requests under `#### Section` headers."
        },
        "httpyacPrimeNav.showPinned": {
          "type": "boolean",
          "default": true,
          "description": "Show a Pinned group at the top of the tree for favorited requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "npm run compile-tests && vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
